# Public market data, OBSERVE and local PAPER need no credentials.
# Copy to .env.local, edit locally, and source it with `set -a` before starting.
# The Rust engine and scripts/dev.sh do NOT load this file automatically.
# Guide: docs/EXECUTION.md (all environment variables and account requirements).
# Use the original data directory to keep its history/model/configuration.
# Existing validation data in this workspace: data/live-validation.
MICRO_ALPHA_DATA=data/personal
# Leave empty to disable private exchange access; binance or okx enables it.
MICRO_ALPHA_EXECUTION=
# Both Binance testnet and OKX Demo Trading use the value "testnet" here.
MICRO_ALPHA_EXECUTION_ENV=testnet
# Private execution notional cap in USDT, valid range 10..500; not a deposit amount.
MICRO_ALPHA_LIVE_CAP=100
# Credentials must match the selected venue and environment. Quote values locally.
MICRO_ALPHA_API_KEY=
MICRO_ALPHA_API_SECRET=
# Required only for OKX; this is the API passphrase, not the website password.
MICRO_ALPHA_API_PASSPHRASE=
# Funded endpoints and AUTO each require a separate explicit opt-in.
MICRO_ALPHA_ALLOW_LIVE=NO
MICRO_ALPHA_ALLOW_AUTO=NO
# OFF keeps the complete product and factual summaries working without an LLM.
MICRO_ALPHA_AI_MODE=OFF
# Set ASSIST above to use an already-installed local Ollama model.
# Ollama must be running on 127.0.0.1:11434; no remote AI API key is required.
# MICRO_ALPHA_ASSIST_MODEL=your-local-model
# Needed only for the background research worker; install research/requirements.txt.
# MICRO_ALPHA_PYTHON=.venv/bin/python
