# Public market data, OBSERVE and local PAPER need no credentials.
# Copy to .env.local, edit locally, and source it with `set -a` before starting.
MICRO_ALPHA_DATA=data/personal
# Leave empty to disable private exchange access; binance or okx enables it.
MICRO_ALPHA_EXECUTION=
MICRO_ALPHA_EXECUTION_ENV=testnet
MICRO_ALPHA_LIVE_CAP=100
MICRO_ALPHA_API_KEY=
MICRO_ALPHA_API_SECRET=
MICRO_ALPHA_API_PASSPHRASE=
# Funded endpoints and AUTO each require a separate explicit opt-in.
MICRO_ALPHA_ALLOW_LIVE=NO
MICRO_ALPHA_ALLOW_AUTO=NO
# OFF keeps the complete product and factual summaries working without an LLM.
MICRO_ALPHA_AI_MODE=OFF
# Set ASSIST above to use an already-installed local Ollama model.
# MICRO_ALPHA_ASSIST_MODEL=your-local-model
# MICRO_ALPHA_PYTHON=.venv/bin/python
